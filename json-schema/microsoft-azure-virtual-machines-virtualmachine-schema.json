      "readOnly": true,
      "description": "Resource name."
    },
    "type": {
      "type": "string",
      "readOnly": true,
      "description": "Resource type."
    },
    "location": {
      "type": "string",
      "description": "Resource location."
    },
    "tags": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Resource tags."
    },
    "properties": {
      "$ref": "#/components/schemas/VirtualMachineProperties"
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "string"
